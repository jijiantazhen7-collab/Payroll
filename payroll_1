  const M=Array.from({length:12},(_,i)=>({m:i+1,v:{}}));
  if(basis==='work'){
    state.shifts.forEach(s=>{if(!s.date.startsWith(String(y)))return;const r=calc(s),m=+s.date.slice(5,7)-1,o=M[m].v[s.jobId]||(M[m].v[s.jobId]={pay:0,work:0});o.pay+=r.pay;o.work+=r.work});
