<script>
const KEY='shiftcalc.v1';
let state={settings:{wage:1200,transport:0,night:true,ot:true},shifts:[]};
try{const s=JSON.parse(localStorage.getItem(KEY));if(s&&s.settings&&Array.isArray(s.shifts))state=s}catch(e){}
const PAL=[['#0f766e','#1d4ed8'],['#c2410c','#be185d'],['#6d28d9','#a16207'],['#b91c1c','#475569'],['#4d7c0f','#0369a1']];
const COLORS=PAL.map(p=>p[0]);
function normalize(){

if(!state.settings)state.settings={};if(!state.paid||typeof state.paid!=='object')state.paid={};if(!Array.isArray(state.shifts))state.shifts=[];
state.templates=Array.isArray(state.templates)?state.templates:[];
if(!Array.isArray(state.jobs)||!state.jobs.length){const s0=state.settings||{};state.jobs=[{id:'j1',name:'バイト先A',color:COLORS[0],wage:s0.wage??1200,transport:s0.transport||0,night:s0.night!==false,ot:s0.ot!==false},{id:'j2',name:'バイト先B',color:COLORS[1],wage:1200,transport:0,night:true,ot:true}]}

state.jobs.forEach((j,i)=>{if(j.pal==null)j.pal=i;const P=PAL[j.pal]||PAL[0];if(!P.includes(j.color))j.color=P[0]});
state.jobs.forEach(j=>{if(j.cram){if(j.lessonMin===80)j.lessonMin=90;ensureCram(j)}});
state.jobs.forEach(j=>{if(j.lastTime===undefined&&!j.cram&&false)j.lastTime='21:00';if(j.close==null)j.close=0;if(j.payOff==null)j.payOff=1;if(j.payDay==null)j.payDay=25});
if(!Array.isArray(state.other))state.other=[];
if(Array.isArray(state.layoutHidden))state.layoutHidden=state.layoutHidden.filter(k=>k!=='total');if(state.collapsed)delete state.collapsed['sec-total'];
state.cur=state.jobs.some(j=>j.id===state.cur&&(!j.ended||j.ended>=todayStr0()))?state.cur:((state.jobs.find(j=>!j.ended||j.ended>=todayStr0())||state.jobs[0]).id);
state.shifts.forEach(s=>{if(!s.jobId||!state.jobs.some(j=>j.id===s.jobId))s.jobId=state.jobs[0].id});state.templates.forEach(t=>{if(!t.jobId||!state.jobs.some(j=>j.id===t.jobId))t.jobId=state.jobs[0].id});
}
normalize();
const jobOf=id=>state.jobs.find(j=>j.id===id)||state.jobs[0];
// 改定日に応じた時給: J.raises=[{id,from,wage?,adminWage?,grades:{gid:wage}}]
function raiseAt(J,date){return (J.raises||[]).filter(r=>r.from&&r.from<=date).sort((a,b)=>a.from.localeCompare(b.from))}
function jobAt(id,date){const J=jobOf(id),A=raiseAt(J,date);if(!A.length)return J;const E={...J};
  A.forEach(r=>{if(r.wage!=null&&r.wage!=='')E.wage=+r.wage;if(r.adminWage!=null&&r.adminWage!=='')E.adminWage=+r.adminWage});
  if(J.grades)E.grades=J.grades.map(g=>{let w=g.wage;A.forEach(r=>{const v=r.grades&&r.grades[g.id];if(v!=null&&v!=='')w=+v});return{...g,wage:w}});
  return E}
const eT=(jid,t,full)=>{const J=state.jobs.find(j=>j.id===jid);return J&&J.lastTime&&t===J.lastTime?'L':(full?t:t.replace(':00',''))};
const isActive=j=>!j.ended||j.ended>=todayStr0();
function todayStr0(){const t=new Date();return `${t.getFullYear()}-${String(t.getMonth()+1).padStart(2,'0')}-${String(t.getDate()).padStart(2,'0')}`}
const activeJobs=()=>{const a=state.jobs.filter(isActive);return a.length?a:state.jobs};
const inRange=(J,P)=>(!J.ended||P.start<=J.ended)&&(!J.started||P.end>=J.started);
let cloudRef=null,cloudTimer=null,cloudChain=Promise.resolve(),lastCloud='';
const saveLocal=()=>{try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}};
const save=()=>{saveLocal();if(cloudRef){clearTimeout(cloudTimer);cloudTimer=setTimeout(pushCloud,800)}};
// 3-way merge: base = last state both sides agreed on; local edits win over remote only where local changed
function mergeList(b,l,r){
  const B=new Map((b||[]).map(x=>[x.id,JSON.stringify(x)])),L=new Map((l||[]).map(x=>[x.id,x])),out=new Map((r||[]).map(x=>[x.id,x]));
  L.forEach((x,id)=>{if(!B.has(id)||B.get(id)!==JSON.stringify(x))out.set(id,x)});
  B.forEach((_,id)=>{if(!L.has(id))out.delete(id)});
  return [...out.values()];
}
function merge3(b,l,r){
  const m={...r};
  ['shifts','templates','jobs'].forEach(k=>m[k]=mergeList(b[k],l[k],r[k]));
  Object.keys(l).forEach(k=>{if(['shifts','templates','jobs','paid'].includes(k))return;if(JSON.stringify(l[k])!==JSON.stringify(b[k]))m[k]=l[k]});
  m.paid={...(r.paid||{})};const bp=b.paid||{},lp=l.paid||{};
  Object.keys(lp).forEach(k=>{if(lp[k]!==bp[k])m.paid[k]=lp[k]});Object.keys(bp).forEach(k=>{if(!(k in lp))delete m.paid[k]});
  if(!m.jobs.length)m.jobs=l.jobs;
  return m;
}
function pushCloud(){
  if(JSON.stringify(state)===lastCloud)return;
  cloudChain=cloudChain.then(async()=>{
    try{
      const snap=await cloudRef.get(),rj=snap.exists&&snap.data()&&snap.data().json;
      if(rj&&rj!==lastCloud&&lastCloud){
        const base=JSON.parse(lastCloud),remote=JSON.parse(rj),cur=state;
        state=merge3(base,cur,remote);normalize();saveLocal();refreshAll();
      }
      const json=JSON.stringify(state);if(json===rj){lastCloud=json;setSync('ok');return}
      await cloudRef.set({v:1,json,updatedAt:Date.now()});lastCloud=json;setSync('ok');
    }catch(e){setSync(e&&e.code==='quota_exceeded'?'full':'err')}
  });
}
const $=id=>document.getElementById(id);
const yen=n=>'¥'+Math.round(n).toLocaleString('ja-JP');
const hm=m=>{const h=Math.floor(m/60),r=m%60;return r?`${h}時間${r}分`:`${h}時間`};
const toMin=t=>{const [h,m]=t.split(':').map(Number);return h*60+m};
const pad=n=>String(n).padStart(2,'0');
const today=new Date();
const todayStr=`${today.getFullYear()}-${pad(today.getMonth()+1)}-${pad(today.getDate())}`;

function autoBreak(span){return span>480?60:span>360?45:0}

function calc(s){
  const st=toMin(s.start);let en=toMin(s.end);if(en<=st)en+=1440;
  const span=en-st,work=Math.max(0,span-s.brk);
  const J0=jobAt(s.jobId,s.date);if(J0.cram&&J0.grades)return cramCalc(s,J0,span);
  let n=0;for(let t=st;t<en;t++){const m=t%1440;if(m>=1320||m<300)n++}
  const J=J0,nightWork=Math.min(n,work),w=J.wage;
  let pay=work/60*w;
  if(J.night)pay+=nightWork/60*w*.25;
  if(J.ot)pay+=Math.max(0,work-480)/60*w*.25;
  pay+=J.transport;
  return{work,pay};
}

function currentInput(){
  const start=$('start').value,end=$('end').value;
  if(!start||!end)return null;
  const st=toMin(start);let en=toMin(end);if(en<=st)en+=1440;
  if($('auto').checked)$('brk').value=autoBreak(en-st);
  $('brk').disabled=$('auto').checked;
  return{date:$('date').value,start,end,brk:Math.max(0,Number($('brk').value)||0),jobId:state.cur,gid:$('gSel').value};
}

function renderPreview(){
  const s=currentInput();
  $('preview').textContent=s?(()=>{const r=calc(s);return `実働 ${hm(r.work)} ／ この日の給与 ${yen(r.pay)}`})():'開始と終了の時刻を入力してください';
}

function render(keep){
  YTC={};
  const m=$('month').value;
  const list=state.shifts.filter(s=>s.date.startsWith(m)).sort((a,b)=>(a.date+a.start).localeCompare(b.date+b.start));
  let pay=0,work=0;
  $('list').innerHTML=list.length?list.map(s=>{
    const r=calc(s);pay+=r.pay;work+=r.work;
    const d=new Date(s.date+'T00:00');
    const label=`${d.getMonth()+1}/${d.getDate()}（${'日月火水木金土'[d.getDay()]}）`;
    return `<div class="item"><div><div class="d">${dot(s.jobId)}${label}${holTag(s.date)}</div><div class="t">${s.start}〜${eT(s.jobId,s.end,1)}　${gLabel(s)}実働${hm(r.work)}</div></div><div style="display:flex;align-items:center;gap:8px"><span class="p">${yen(r.pay)}</span><button class="ghost" data-edit="${s.date}" type="button" style="color:var(--ink)" aria-label="${label}のシフトを編集">編集</button><button class="ghost" data-id="${s.id}" type="button" aria-label="${label}のシフトを削除">削除</button></div></div>`
  }).join(''):'<div class="empty">この月のシフトはまだありません。上のフォームから追加してください。</div>';
  {const [yy,mm]=m.split('-').map(Number),cur=m===todayStr.slice(0,7);$('sumLbl').innerHTML=`${yy}年${mm}月の見込み給与${cur?'（今月）':''}${state.showRange!==false?`<br><small style="font-weight:400;opacity:.85">${mm}/1〜${mm}/${lastDay(yy,mm)}の勤務分</small>`:''}`;$('showRange').checked=state.showRange!==false}
  $('sumPay').textContent=yen(pay);
  $('sumDays').textContent=new Set(list.map(s=>s.date)).size+'日';
  $('sumHours').textContent=hm(work);
  renderBy(list);renderPay();renderInMonth();try{if(typeof exRender==='function')exRender()}catch(e){console.error(e)}try{if(typeof grRender==='function')grRender()}catch(e){console.error(e)}try{renderWallAlert()}catch(e){console.error(e)}if(typeof rqRender==='function'&&$('rqCal')&&!$('rqCal').contains(document.activeElement))try{rqRender()}catch(e){console.error(e)}if(typeof cmpRender==='function'&&$('cJob'))try{cmpRender()}catch(e){}if(typeof fyRender==='function'&&$('fySec'))try{fyRender()}catch(e){console.error(e)}if(typeof updateHeads==='function')try{updateHeads();updateStaticFolds()}catch(e){}if(!keep)renderCur();
  renderCal(keep);
  if(!keep)renderTpl();
}

function loadSettings(){
  $('wage').value=state.settings.wage;$('transport').value=state.settings.transport;
  $('night').checked=state.settings.night;$('ot').checked=state.settings.ot;$('who').value=state.who||'';
}
function readSettings(){
  state.settings={wage:Math.max(0,Number($('wage').value)||0),transport:Math.max(0,Number($('transport').value)||0),night:$('night').checked,ot:$('ot').checked};
  save();render();renderPreview();
}


['start','end','brk','auto'].forEach(id=>$(id).addEventListener('input',renderPreview));
$('month').addEventListener('input',()=>render());
$('showRange').addEventListener('change',e=>{state.showRange=e.target.checked;save();render()});
$('add').addEventListener('click',()=>{
  const s=currentInput();
  if(!s||!s.date){$('preview').textContent='日付と時刻を入力してください';return}
  state.shifts.push({id:Date.now().toString(36)+Math.random().toString(36).slice(2,6),...s});
  save();$('month').value=s.date.slice(0,7);render();renderPreview();
});
$('list').addEventListener('click',e=>{
  const ed=e.target.dataset&&e.target.dataset.edit;if(ed){openDay(ed);return}
  const id=e.target.dataset&&e.target.dataset.id;if(!id)return;
  state.shifts=state.shifts.filter(s=>s.id!==id);save();render();
});

function ensureCram(j){
  if(!j.grades||!j.grades.length)j.grades=[{id:'g1',name:'小学生',wage:1200},{id:'g2',name:'中学生',wage:1300},{id:'g3',name:'高校生',wage:1400}];
  if(j.adminWage==null)j.adminWage=1000;if(j.adminBefore==null)j.adminBefore=5;if(j.adminAfter==null)j.adminAfter=5;if(j.lessonMin==null)j.lessonMin=90;if(j.adminGap==null)j.adminGap=5;if(!j.slots||!j.slots.length)j.slots=[{start:'16:20',end:'17:50'},{start:'17:55',end:'19:25'},{start:'19:30',end:'21:00'}];
}
function isFirstDay(s){return !state.shifts.some(x=>x!==s&&x.jobId===s.jobId&&x.date===s.date&&(x.start<s.start||(x.start===s.start&&x.id<s.id)))}
function cramCalc(s,J,span){
  const g=J.grades.find(x=>x.id===s.gid)||J.grades[0];
  const L=state.shifts.filter(x=>x.jobId===s.jobId&&x.date===s.date);if(!L.includes(s))L.push(s);
  L.sort((a,b)=>a.start.localeCompare(b.start)||String(a.id).localeCompare(String(b.id)));
  const i=L.indexOf(s),first=i===0,nx=L[i+1];
  const adm=(first?(J.adminBefore||0):0)+(nx?Math.min(Math.max(0,toMin(nx.start)-(toMin(s.start)+span)),J.adminGap??5):(J.adminAfter||0));
  let pay=span/60*g.wage+adm/60*(J.adminWage||0);
  if(first)pay+=J.transport;
  return{work:span+adm,pay};
}
function gLabel(s){const J=jobOf(s.jobId);if(J.cram&&J.grades){const g=J.grades.find(x=>x.id===s.gid)||J.grades[0];return (s.kind==='special'?'【講習】':'')+esc(g.name)+'　'}return `休憩${s.brk}分　`}
function gradeOrBrk(s){const J=jobOf(s.jobId);if(J.cram&&J.grades)return `<label>学年<select data-f="gid">${J.grades.map(g=>`<option value="${g.id}"${g.id===s.gid||(!s.gid&&g===J.grades[0])?' selected':''}>${esc(g.name)}</option>`).join('')}</select></label><label>種別<select data-f="kind"><option value="">通常授業</option><option value="special"${s.kind==='special'?' selected':''}>講習</option></select></label>`;return `<label>休憩（分）<input type="number" data-f="brk" min="0" step="5" value="${s.brk}"></label>`}
function newShift(date){
  const J=jobOf(state.cur);
  if(!J.cram||!J.grades)return{id:uid(),date,start:'17:00',end:'22:00',brk:autoBreak(300),jobId:state.cur};
  const L=state.shifts.filter(x=>x.jobId===J.id&&x.date===date).sort((a,b)=>a.end.localeCompare(b.end));
  const st=toMin(J.slots&&J.slots[0]?J.slots[0].start:'16:20'),f=m=>pad(Math.floor(m/60)%24)+':'+pad(m%60);
  return{id:uid(),date,start:f(st),end:f(st+(J.lessonMin||90)),brk:0,jobId:J.id,gid:J.grades[0].id};
}
function cramBlock(j){
  let h='';
  if(!j.cram)return h;
  h+=`<p class="note" style="margin:10px 0 4px">学年ごとの授業時給。金額は仮の値なので、実際の金額に直してください。</p>`;
