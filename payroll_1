// ---- 重なりチェック ----
function dayBlocks(ds){
  const out=[];
  state.jobs.forEach(J=>{
    const L=state.shifts.filter(s=>s.jobId===J.id&&s.date===ds).sort((a,b)=>a.start.localeCompare(b.start));if(!L.length)return;
    if(J.cram&&J.grades){const ends=L.map(s=>{const st=toMin(s.start);let en=toMin(s.end);if(en<=st)en+=1440;return en});out.push({J,s:toMin(L[0].start)-(J.adminBefore||0),e:Math.max(...ends)+(J.adminAfter||0),ids:L.map(x=>x.id)})}
    else L.forEach(x=>{const st=toMin(x.start);let en=toMin(x.end);if(en<=st)en+=1440;out.push({J,s:st,e:en,ids:[x.id]})});
  });
  return out.sort((a,b)=>a.s-b.s);
}
const hhmm=m=>pad(Math.floor(((m%1440)+1440)%1440/60))+':'+pad(((m%60)+60)%60);
function conflictsOn(ds){
  const B=dayBlocks(ds),tr=state.travel??30,out=[];
  for(let i=0;i<B.length;i++)for(let j=i+1;j<B.length;j++){const a=B[i],b=B[j];
    if(a.s<b.e&&b.s<a.e)out.push({type:a.J===b.J?'dup':'overlap',a,b,txt:a.J===b.J?`${esc(a.J.name)}のシフトが重なっています（${hhmm(a.s)}〜${hhmm(a.e)} と ${hhmm(b.s)}〜${hhmm(b.e)}）。二重に入っていないか確認してください。`:`${esc(a.J.name)}（〜${hhmm(a.e)}）と${esc(b.J.name)}（${hhmm(b.s)}〜）の時間が重なっています。`});
    else if(a.J!==b.J&&b.s>=a.e&&b.s-a.e<tr)out.push({type:'tight',a,b,txt:`${esc(a.J.name)}の終わり（${hhmm(a.e)}）から${esc(b.J.name)}の始まり（${hhmm(b.s)}）まで${b.s-a.e}分しかありません（移動時間${tr}分）。`});
  }
  return out;
}
