$('rqMsg').addEventListener('input',()=>{rqData().msg=$('rqMsg').value;save();$('rqText').value=rqText()});
$('rqOthers').addEventListener('click',()=>{const D=rqData(),ym=$('rqMonth').value,jid=$('rqJob').value,ds=[...new Set(state.shifts.filter(s=>s.date.startsWith(ym)&&s.jobId!==jid).map(s=>s.date))];ds.forEach(d=>D.d[d]={t:'off'});save();rqRender();render(true);$('rqNote').textContent=ds.length?`ほかのバイト先のシフトがある${ds.length}日を休みにしました。`:'ほかのバイト先のシフトがある日はありません。'});
$('rqClear').addEventListener('click',()=>{state.req=state.req||{};delete state.req[rqKey()];rqSel=null;save();rqRender();render(true);$('rqNote').textContent='この月の仮のシフトを消しました。'});
$('rqCommit').addEventListener('click',()=>{
  const D=rqData(),J=jobOf($('rqJob').value);let n=0,skip=0,left=0;
  Object.keys(D.d).sort().forEach(ds=>{const v=rqNorm(D.d[ds]);if(v.t!=='ok')return;
    if(state.shifts.some(s=>s.jobId===J.id&&s.date===ds)){skip++;return}
    let done=false;
    if(J.cram&&J.slots){(v.slots||[]).forEach(id=>{const sl=J.slots['ABCDEFGH'.indexOf(id)];if(sl){state.shifts.push({id:uid(),date:ds,start:sl.start,end:sl.end,brk:0,jobId:J.id,gid:J.grades[0].id,slot:id});n++;done=true}})}
    else if(v.start&&v.end){const st=toMin(v.start);let en=toMin(v.end);if(en<=st)en+=1440;state.shifts.push({id:uid(),date:ds,start:v.start,end:v.end,brk:v.brk??autoBreak(en-st),jobId:J.id});n++;done=true}
    if(done)delete D.d[ds];else left++});
  save();render();rqRender();$('rqNote').textContent=`${n}件を本番のシフトに登録しました${skip?`（すでにシフトがある${skip}日はそのまま）`:''}${left?`。時間やコマが入っていない${left}日は仮のまま残しています`:''}。${J.cram?'学年は日付の画面で選んでください。':''}`});
$('rqCopy').addEventListener('click',async()=>{const t=$('rqText').value,n=$('rqNote');try{await navigator.clipboard.writeText(t);n.textContent='コピーしました。LINEなどに貼り付けてください。';return}catch(e){}
  const ta=$('rqText');ta.removeAttribute('readonly');ta.focus();ta.select();let ok=false;try{ok=document.execCommand('copy')}catch(e){}ta.setAttribute('readonly','');n.textContent=ok?'コピーしました。LINEなどに貼り付けてください。':'自動でコピーできませんでした。文章が選ばれた状態なので、長押ししてコピーしてください。'});
// メインのカレンダーに出す仮のシフト
function tentativeOn(ds){const out=[];const ym=ds.slice(0,7);Object.keys(state.req||{}).forEach(k=>{if(!k.startsWith(ym+'|'))return;const jid=k.split('|')[1],v=rqNorm((state.req[k].d||{})[ds]);if(!v||v.t!=='ok')return;if(state.shifts.some(s=>s.jobId===jid&&s.date===ds))return;const J=jobOf(jid);if(!J||J.id!==jid)return;out.push({J,label:J.cram&&J.slots?(v.slots||[]).join(''):(v.start&&v.end?`${ct(v.start)}-${eT(jid,v.end)}`:'')})});return out}

// ---- 折りたたみ ----
const isCol=k=>!!(state.collapsed&&state.collapsed[k]);
function fold(key,title,sum,inner,extra){return `<div class="fold${isCol(key)?' closed':''}" data-fold="${key}"${extra||''}><button type="button" class="fold-h" data-fold-t="${key}" aria-expanded="${!isCol(key)}"><span>${title}</span><span class="sm">${sum||''}</span><span class="chev" aria-hidden="true">▼</span></button><div class="fold-b">${inner}</div></div>`}
function secSummary(k){
  try{
    if(k==='total'){const ym=$('month').value,mm=+ym.slice(5);let nx=null;activeJobs().forEach(J=>{for(let i=-3;i<=3;i++){const dt=new Date(today.getFullYear(),today.getMonth()+i,1),P=period(J,dt.getFullYear(),dt.getMonth()+1);if(P.pay>=todayStr&&inRange(J,P)&&(!nx||P.pay<nx))nx=P.pay}});return `${mm}月 ${$('sumPay').textContent}${nx?`・次の給料日 ${md(nx)}`:''}`}
    if(k==='cur')return esc(jobOf(state.cur).name);
    if(k==='cal')return $('calTitle').textContent;
    if(k==='cmp'){const o=$('cPer').selectedOptions[0];return o?esc(jobOf($('cJob').value).name)+'・'+o.textContent.split('（')[0]:''}
    if(k==='fuyo')return fyLast||'';
    if(k==='jobs'){const a=state.jobs.filter(isActive).length,e=state.jobs.length-a;return `${a}件${e?`（辞めた${e}件）`:''}`}
    if(k==='tpl')return `${state.templates.length}件`;
    if(k==='export')return $('exInfo').textContent;
    if(k==='graph'){const d=$('grChart')&&$('grChart')._d;return d?`${d.y}年 ${d.key==='pay'?yen(d.tot.reduce((a,b)=>a+b,0)):hm(Math.round(d.tot.reduce((a,b)=>a+b,0)))}`:''}
    if(k==='req'){const ym=$('rqMonth').value;return ym?`${esc(jobOf($('rqJob').value).name)}・${+ym.slice(5)}月 ${$('rqCount').textContent}`:''}
    if(k==='list'){const ym=$('month').value;return `${+ym.slice(5)}月 ${state.shifts.filter(s=>s.date.startsWith(ym)).length}件`}
  }catch(e){}
  return '';
}
function updateStaticFolds(){document.querySelectorAll('main [data-sec] .fold[data-fold]').forEach(f=>{const c=isCol(f.dataset.fold);f.classList.toggle('closed',c);const b=f.querySelector(':scope>.fold-h');if(b)b.setAttribute('aria-expanded',String(!c))});
  const t=(id,v)=>{const e=$(id);if(e)e.textContent=v};
  try{t('rqSm1',$('rqCount').textContent);t('rqSm2',($('rqFmt').selectedOptions[0]||{}).textContent||'');const d=$('grChart')._d;if(d)t('grSm',`${d.y}年 ${d.key==='pay'?yen(d.tot.reduce((a,b)=>a+b,0)):hm(Math.round(d.tot.reduce((a,b)=>a+b,0)))}`);t('trSm',`${state.travel??30}分`);t('slSm',$('slBox')&&!$('slBox').hidden?'写真で明細を入れる':'')}catch(e){}}
function updateHeads(){document.querySelectorAll('main>[data-sec]').forEach(el=>{const k=el.dataset.sec;if(k==='total'){el.classList.remove('collapsed');const x=el.querySelector(':scope>.sechead');if(x)x.remove();return}let h=el.querySelector(':scope>.sechead');if(!h){h=document.createElement('div');h.className='sechead';const bar=el.querySelector(':scope>.secbar');bar?bar.after(h):el.prepend(h)}
  const c=isCol('sec-'+k);el.classList.toggle('collapsed',c);h.innerHTML=`<button type="button" class="sechead-b" data-sect="${k}" aria-expanded="${!c}"><span>${esc(el.dataset.name)}</span><span class="sm">${secSummary(k)}</span><span class="chev" aria-hidden="true">▼</span></button>`})}
document.addEventListener('click',e=>{
  const st=e.target.closest('[data-sect]');if(st){const k='sec-'+st.dataset.sect;state.collapsed={...(state.collapsed||{}),[k]:!isCol(k)};if(!state.collapsed[k])delete state.collapsed[k];save();updateHeads();return}
  const ft=e.target.closest('[data-fold-t]');if(ft){const k=ft.dataset.foldT;state.collapsed={...(state.collapsed||{}),[k]:!isCol(k)};if(!state.collapsed[k])delete state.collapsed[k];save();const f=ft.closest('.fold');f.classList.toggle('closed',isCol(k));ft.setAttribute('aria-expanded',String(!isCol(k)))}
});
// ---- 表示の並べ替え ----
const SEC_DEFAULT=['total','cur','cal','req','graph','cmp','fuyo','jobs','tpl','photo','manual','list','export'];
function layoutOrder(){const L=Array.isArray(state.layout)?state.layout.filter(k=>SEC_DEFAULT.includes(k)):[];SEC_DEFAULT.forEach((k,i)=>{if(L.includes(k))return;const prev=SEC_DEFAULT.slice(0,i).reverse().find(x=>L.includes(x));L.splice(prev?L.indexOf(prev)+1:0,0,k)});return L}
function applyLayout(){
  const main=document.querySelector('main'),hid=(state.layoutHidden||[]).filter(k=>k!=='total'),order=layoutOrder();
  order.forEach((k,i)=>{const el=main.querySelector(`[data-sec="${k}"]`);if(!el)return;main.appendChild(el);if(k==='cal')main.appendChild($('dayEd'));el.classList.toggle('uhid',k!=='total'&&hid.includes(k));
    let bar=el.querySelector(':scope>.secbar');if(!bar){bar=document.createElement('div');bar.className='secbar';el.prepend(bar)}
    const h=hid.includes(k);bar.innerHTML=`<b>${esc(el.dataset.name)}${h?'（非表示）':''}</b><button type="button" class="ghost" data-mv="${k}|-1" style="color:var(--ink)"${i===0?' disabled':''} aria-label="上へ">▲</button><button type="button" class="ghost" data-mv="${k}|1" style="color:var(--ink)"${i===order.length-1?' disabled':''} aria-label="下へ">▼</button>${k==='total'?'<small style="color:var(--muted);font-weight:500;padding:0 4px">常に表示</small>':`<button type="button" class="ghost" data-hide="${k}" style="color:${h?'var(--accent)':'var(--warn)'}">${h?'表示する':'隠す'}</button>`}`});
}
const _al=applyLayout;applyLayout=function(){_al();updateHeads()};
$('layoutBtn').addEventListener('click',()=>{const on=!document.body.classList.contains('edit-layout');document.body.classList.toggle('edit-layout',on);$('layoutBtn').textContent=on?'完了':'並べ替え';if(on){applyLayout();if(!$('layoutHelp')){const p=document.createElement('p');p.id='layoutHelp';p.className='note';p.style.margin='0 0 12px';p.innerHTML='▲▼で順番を入れ替え、「隠す」で表示しない欄を選べます。<button type="button" class="ghost" id="layoutReset" style="color:var(--ink);margin-left:6px">元の並びに戻す</button>';$('syncSt').after(p)}$('layoutHelp').hidden=false}else if($('layoutHelp'))$('layoutHelp').hidden=true});
document.querySelector('main').addEventListener('click',e=>{
  if(e.target.id==='layoutReset'){state.layout=SEC_DEFAULT.slice();state.layoutHidden=[];save();applyLayout();return}
  const mv=e.target.dataset&&e.target.dataset.mv,hd=e.target.dataset&&e.target.dataset.hide;if(hd==='total')return;
  if(mv){const[k,d]=mv.split('|'),L=layoutOrder(),i=L.indexOf(k),j=i+(+d);if(j<0||j>=L.length)return;[L[i],L[j]]=[L[j],L[i]];state.layout=L;save();applyLayout();const el=document.querySelector(`main>[data-sec="${k}"]`);if(el)el.scrollIntoView({block:'nearest'});return}
  if(hd){const H=new Set(state.layoutHidden||[]);H.has(hd)?H.delete(hd):H.add(hd);state.layoutHidden=[...H];save();applyLayout()}
});
$('date').value=todayStr;
$('month').value=todayStr.slice(0,7);

$('travelMin').value=state.travel??30;
$('who').value=state.who||'';renderJobs();renderPreview();render();applyLayout();

function setSync(k){
  $('syncSt').textContent={ok:'アカウントに保存しています（スマホとPCで同期）',load:'アカウントのデータを読み込み中…',err:'アカウントへの保存に失敗しました。この端末には保存されています。',full:'保存容量がいっぱいです。古いシフトを削除してください。',local:'この端末に保存しています（バックアップはページ下の「書き出し」から）'}[k]||'';
}
function refreshAll(){
  if(document.activeElement!==$('travelMin'))$('travelMin').value=state.travel??30;
  if(typeof applyLayout==='function')applyLayout();
  if(document.activeElement!==$('who'))$('who').value=state.who||'';
  if(!$('jobs').contains(document.activeElement))renderJobs();
  renderPreview();{const a=document.activeElement;render(!!(a&&$('dayEd').contains(a)&&a.tagName==='INPUT'))}
}
function mergeLocalInto(c){
  const key=s=>[s.jobId,s.date,s.start,s.end].join('|');
  const ids=new Set(c.shifts.map(s=>s.id)),keys=new Set(c.shifts.map(key));
  state.shifts.forEach(s=>{if(!ids.has(s.id)&&!keys.has(key(s)))c.shifts.push(s)});
  const tn=new Set(c.templates.map(t=>t.jobId+'|'+t.name));
  state.templates.forEach(t=>{if(!tn.has(t.jobId+'|'+t.name))c.templates.push(t)});
  return c;
}
(async()=>{
  let db=null,user=null;
  try{if(window.claude&&claude.use){[db,user]=await Promise.all([claude.use('db'),claude.use('user')])}}catch(e){}
  if(!db||!user){setSync('local');return}
  let uidv=null;try{uidv=await user.id()}catch(e){}
  if(!uidv){setSync('local');return}
  setSync('load');
  const ref=db.collection('data/users/'+uidv).doc('state');
  let snap=null;
  for(let t=0;t<2&&!snap;t++){try{snap=await ref.get()}catch(e){if(!e||e.code!=='unavailable'||t){setSync('local');return}await new Promise(r=>setTimeout(r,500+Math.random()*700))}}
  let synced=false;try{synced=localStorage.getItem(KEY+'.synced')==='1'}catch(e){}
  const hasLocal=state.shifts.length>0||state.templates.length>0;
  const remote=snap.exists&&snap.data()&&typeof snap.data().json==='string'?snap.data().json:null;
  cloudRef=ref;
  if(remote){
    let c=null;try{c=JSON.parse(remote)}catch(e){}
    if(c){
      if(!synced&&hasLocal){
        const backup=state;state=c;normalize();const cn=state;state=backup;
        state=mergeLocalInto(cn);normalize();saveLocal();refreshAll();pushCloud();
      }else{lastCloud=remote;state=c;normalize();saveLocal();refreshAll()}
    }
  }else if(hasLocal){pushCloud()}
  try{localStorage.setItem(KEY+'.synced','1')}catch(e){}
  setSync('ok');
  ref.onSnapshot(s=>{
    const d=s.exists&&s.data();if(!d||typeof d.json!=='string'||d.json===lastCloud)return;
    const mine=JSON.stringify(state);if(d.json===mine){lastCloud=d.json;return}
    try{
      const c=JSON.parse(d.json);
      if(lastCloud&&mine!==lastCloud){state=merge3(JSON.parse(lastCloud),state,c);lastCloud=d.json;normalize();saveLocal();refreshAll();clearTimeout(cloudTimer);cloudTimer=setTimeout(pushCloud,300)}
      else{lastCloud=d.json;state=c;normalize();saveLocal();refreshAll()}
    }catch(e){}
  },()=>setSync('err'));
})();
